{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindforge.local/contracts/content_asset_recipe.v1.schema.json",
  "title": "Mindforge Content Asset Recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "asset_id",
    "semantic_role",
    "districts",
    "source",
    "geometry",
    "render",
    "unity",
    "authority",
    "quality"
  ],
  "properties": {
    "schema": {"const": "mindforge.content_asset_recipe.v1"},
    "asset_id": {"type": "string", "pattern": "^mf_[a-z0-9_]+$"},
    "semantic_role": {
      "enum": ["column", "arch", "door", "spire", "tree", "rock", "prop", "humanoid", "robot"]
    },
    "districts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tool", "tool_version", "license", "redistribution_policy"],
      "properties": {
        "kind": {"enum": ["generated_fallback", "authored", "local_art", "ai_generated"]},
        "tool": {"type": "string", "minLength": 1},
        "tool_version": {"type": "string", "minLength": 1},
        "prompt_hash": {"type": ["string", "null"]},
        "reference_hashes": {"type": "array", "items": {"type": "string"}},
        "license": {"type": "string", "minLength": 1},
        "redistribution_policy": {"enum": ["repository_safe", "local_only", "build_only"]}
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_size_m", "forward_axis", "up_axis", "pivot_policy", "max_triangles", "max_submeshes"],
      "properties": {
        "target_size_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "forward_axis": {"enum": ["+x", "-x", "+y", "-y", "+z", "-z"]},
        "up_axis": {"enum": ["+x", "-x", "+y", "-y", "+z", "-z"]},
        "pivot_policy": {"enum": ["bottom_center", "center", "authored"]},
        "max_triangles": {"type": "integer", "minimum": 12},
        "max_submeshes": {"type": "integer", "minimum": 1, "maximum": 16}
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_family", "max_materials", "texture_max_px", "lod_ratios", "cast_shadows", "receive_shadows"],
      "properties": {
        "material_family": {"type": "string", "minLength": 1},
        "max_materials": {"type": "integer", "minimum": 1, "maximum": 8},
        "texture_max_px": {"type": "integer", "minimum": 128, "maximum": 4096},
        "lod_ratios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
        },
        "cast_shadows": {"type": "boolean"},
        "receive_shadows": {"type": "boolean"}
      }
    },
    "unity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_tokens", "fallback_symbol"],
      "properties": {
        "target_tokens": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "fallback_symbol": {"type": "string", "minLength": 1}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameplay", "collision", "bci"],
      "properties": {
        "gameplay": {"const": false},
        "collision": {"const": false},
        "bci": {"const": false}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_score", "require_finite_normals", "require_nonzero_bounds", "reject_magenta_material"],
      "properties": {
        "minimum_score": {"type": "number", "minimum": 0, "maximum": 1},
        "require_finite_normals": {"const": true},
        "require_nonzero_bounds": {"const": true},
        "reject_magenta_material": {"const": true}
      }
    }
  }
}
